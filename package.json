{
    "name": "elmishphp-html-e2e",
    "version": "0.0.0",
    "private": true,
    "description": "E2E tests for ElmishPHP-HTML using Playwright",
    "scripts": {
        "test:e2e": "npx playwright test --config tests/e2e/playwright.config.js",
        "test:e2e:ui": "npx playwright test --config tests/e2e/playwright.config.js --ui",
        "test:e2e:headed": "npx playwright test --config tests/e2e/playwright.config.js --headed",
        "test:e2e:setup": "npx playwright test --config tests/e2e/playwright.config.js --project=setup",
        "server:up": "docker compose -f tests/e2e/docker-compose.yml up -d",
        "server:down": "docker compose -f tests/e2e/docker-compose.yml down",
        "server:logs": "docker compose -f tests/e2e/docker-compose.yml logs -f"
    },
    "devDependencies": {
        "@playwright/test": "^1.50.0"
    }
}
